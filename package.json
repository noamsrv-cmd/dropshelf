{
  "name": "dropshelf",
  "version": "1.0.0",
  "description": "A beautiful temporary shelf for anything on your computer.",
  "desktopName": "DropShelf",
  "author": {
    "name": "Noam",
    "email": "224560196+noamsrv-cmd@users.noreply.github.com"
  },
  "license": "MIT",
  "private": false,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "app.dropshelf.desktop",
    "productName": "DropShelf",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "DropShelf-Windows-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DropShelf"
    },
    "portable": {
      "artifactName": "DropShelf-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "Noam <224560196+noamsrv-cmd@users.noreply.github.com>",
      "syncDesktopName": true,
      "category": "Utility",
      "target": ["AppImage", "deb"]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noamsrv-cmd/dropshelf.git"
  },
  "keywords": [
    "desktop",
    "productivity",
    "drag-and-drop",
    "clipboard",
    "electron",
    "local-first"
  ]
}
